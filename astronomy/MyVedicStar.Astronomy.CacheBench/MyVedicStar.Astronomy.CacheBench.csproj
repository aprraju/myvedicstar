<Project Sdk="Microsoft.NET.Sdk">

  <!-- api#72 (AST-07): the measurement harness. Deliberately a console app in the astronomy solution, so the numbers a
       report cites are produced by a command in this repository rather than by a laptop session nobody can repeat. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyVedicStar.Astronomy.Core\MyVedicStar.Astronomy.Core.csproj" />
  </ItemGroup>

</Project>
