{
  "version": "2.0.0",
  "tasks": [
    {
      // Restoring MyVedicStar.* packages needs GITHUB_TOKEN (a PAT with read:packages); see nuget.config.
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MyVedicStar.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [ "test", "${workspaceFolder}/MyVedicStar.slnx" ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
