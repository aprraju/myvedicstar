<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>4ac006ce-69a4-47df-b37c-0f8df21afd5c</UserSecretsId>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MyVedicStar.Infrastructure.DependencyInjection/MyVedicStar.Infrastructure.DependencyInjection.csproj" />
    <ProjectReference Include="../MyVedicStar.Email.Business/MyVedicStar.Email.Business.csproj" />
    <ProjectReference Include="../MyVedicStar.Settings.Business/MyVedicStar.Settings.Business.csproj" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="MyVedicStar.ApiProtection" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyVedicStar.Authorize.Business\MyVedicStar.Authorize.Business.csproj" />
    <ProjectReference Include="..\MyVedicStar.Shared\MyVedicStar.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../SharedApi/*.cs" Link="Infrastructure/Shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MyVedicDay.Api/MyVedicDay.Api.csproj" />
    <Content Include="../MyVedicDay.Api/appsettings*.json" Link="apis/day/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="../MyVedicDay.Api/appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.json" TargetPath="apis/star/appsettings.json" />
    <Content Update="appsettings.Development.json" TargetPath="apis/star/appsettings.Development.json" />
    <Content Update="appsettings.Production.json" TargetPath="apis/star/appsettings.Production.json" />
  </ItemGroup>
  <Target Name="RemoveReferencedDaySettings" BeforeTargets="_HandleFileConflictsForPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Production.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>
<ItemGroup><ProjectReference Include="../MyVedicStar.Authorize.Api/MyVedicStar.Authorize.Api.csproj" /><ProjectReference Include="../MyVedicStar.Settings.Api/MyVedicStar.Settings.Api.csproj" /><ProjectReference Include="../MyVedicStar.Email.Api/MyVedicStar.Email.Api.csproj" /></ItemGroup></Project>
