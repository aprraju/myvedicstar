root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Unused usings.
dotnet_diagnostic.IDE0005.severity = warning

# "Shared" is the project naming standard (Product.Shared), not a Visual Basic consumer concern.
dotnet_diagnostic.CA1716.severity = none

# EF Core migrations are generated; analyzers do not apply.
[**/Migrations/*.cs]
generated_code = true

[tests/**.cs]
# Test names use Method_Scenario_Expectation.
dotnet_diagnostic.CA1707.severity = none

# Preserve MyVedicDay's original build policy: its library projects do not emit XML documentation.
[src/MyVedicDay.*/**.cs]
dotnet_diagnostic.IDE0005.severity = none

[tests/MyVedicDay.*/**.cs]
dotnet_diagnostic.IDE0005.severity = none

[src/MyVedicStar.Host/**.cs]
dotnet_diagnostic.IDE0005.severity = none

[tests/MyVedicStar.Host.Tests.Integration/**.cs]
dotnet_diagnostic.IDE0005.severity = none

[src/SharedApi/**.cs]
dotnet_diagnostic.IDE0005.severity = none

[src/MyVedicStar.Caching/**.cs]
dotnet_diagnostic.IDE0005.severity = none
