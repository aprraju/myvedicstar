{
  "$comment": [
    "Application-owned settings for the prod Container App, applied by deploy/scripts/deploy-app.ps1.",
    "Infrastructure (Container App, identity, registry, Key Vault, network) is owned by Terraform; resource names come from GitHub variables.",
    "Nothing here is secret. 'settings' become plain environment variables; 'secrets' map an environment variable to a Key Vault secret name.",
    "Environment variables Terraform already sets on the container are kept unless a key below has the same name.",
    "'removedSettings' lists retired application variables that a release deletes from the container."
  ],
  "containerName": "api",
  "keyVault": {
    "name": "kv-myvedicstar-prod-xw4t",
    "resourceGroup": "rg-myvedicstar-prod-data-eus2"
  },
  "keyVaultIdentityName": "id-myvedicstar-api-prod",
  "settings": {
    "Authentication__EntraExternalId__MetadataAddress": "https://myvedicstarexternal.ciamlogin.com/cbece845-e124-4de7-89d3-96a71abb7b83/v2.0/.well-known/openid-configuration",
    "Authentication__EntraExternalId__TenantDomain": "cbece845-e124-4de7-89d3-96a71abb7b83.ciamlogin.com",
    "Authentication__EntraExternalId__TenantId": "cbece845-e124-4de7-89d3-96a71abb7b83",
    "Authentication__EntraExternalId__ClientId": "fdaa908a-4c0b-4d63-a6d1-de637e0edc4e",
    "FeatureFlags__UserPersistence": "true",
    "Integrations__MicrosoftGraph__Enabled": "true",
    "Integrations__MicrosoftGraph__CredentialType": "ClientSecret",
    "Integrations__MicrosoftGraph__TenantId": "cbece845-e124-4de7-89d3-96a71abb7b83",
    "Integrations__MicrosoftGraph__ClientId": "fdaa908a-4c0b-4d63-a6d1-de637e0edc4e",
    "Database__UseManagedIdentity": "true",
    "TransportSecurity__RedirectHttpToHttps": "false",
    "ApiProtection__TrustedProxies__0": "10.2.0.0/23",
    "Observability__ServiceName": "myvedicstar-api",
    "Caching__L2__Enabled": "true",
    "EmailSettings__Enabled": "true"
  },
  "removedSettings": [
    "ApiDocumentation__Enabled",
    "ForwardedHeaders__KnownNetworks__0",
    "Authentication__EntraExternalId__Audience"
  ],
  "secrets": {
    "Integrations__MicrosoftGraph__ClientSecret": "microsoft-graph-client-secret",
    "EmailSettings__Password": "EmailSettingsPassword"
  },
  "probes": {
    "$comment": "Paths come from HealthChecks in src/MyVedicDay.Api/appsettings.json; port matches ASPNETCORE_HTTP_PORTS.",
    "port": 8080,
    "startup": {
      "initialDelaySeconds": 2,
      "periodSeconds": 5,
      "timeoutSeconds": 3,
      "failureThreshold": 10
    },
    "liveness": {
      "periodSeconds": 15,
      "timeoutSeconds": 3,
      "failureThreshold": 3
    },
    "readiness": {
      "periodSeconds": 10,
      "timeoutSeconds": 5,
      "failureThreshold": 3
    }
  },
  "terminationGracePeriodSeconds": 30,
  "rollout": {
    "readyTimeoutMinutes": 10,
    "pollIntervalSeconds": 10
  },
  "smokeTest": {
    "enabled": true,
    "attempts": 12,
    "retryDelaySeconds": 10,
    "timeoutSeconds": 30
  }
}
