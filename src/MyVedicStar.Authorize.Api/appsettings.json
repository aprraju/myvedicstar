{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore.Database.Command":  "Warning"
                                 },
                    "Console":  {
                                    "FormatterName":  "json",
                                    "FormatterOptions":  {
                                                             "IncludeScopes":  true,
                                                             "UseUtcTimestamp":  true,
                                                             "TimestampFormat":  "yyyy-MM-ddTHH:mm:ss.fffZ"
                                                         }
                                }
                },
    "AllowedHosts":  "*",
    "HostOptions":  {
                        "ShutdownTimeout":  "00:00:25"
                    },
    "Kestrel":  {
                    "Limits":  {
                                   "MaxRequestBodySize":  65536
                               }
                },
    "FeatureFlags":  {
                         "UserPersistence":  false
                     },
    "TransportSecurity":  {
                              "RedirectHttpToHttps":  true
                          },
    "ApiDocumentation":  {
                             "OpenApiRoutePattern":  "/openapi/{documentName}.json",
                             "SwaggerEndpointUrl":  "/openapi/v1.json",
                             "SwaggerUiRoutePrefix":  "swagger",
                             "Title":  "MyVedicStar Authorize API v1",
                             "Description":  "Sign-in and user profile endpoints for MyVedicStar.",
                             "BearerTokenDescription":  "Access token issued by Microsoft Entra External ID.",
                             "HttpsServerUrlsOnly":  true
                         },
    "HealthChecks":  {
                         "LivenessPath":  "/health/live",
                         "ReadinessPath":  "/health/ready"
                     },
    "ApiProtection":  {
                          "RateLimiting":  {
                                               "Global":  {
                                                              "PermitLimit":  200,
                                                              "WindowSeconds":  60
                                                          },
                                               "PublicRead":  {
                                                                  "PermitLimit":  60,
                                                                  "WindowSeconds":  60
                                                              },
                                               "GoodTime":  {
                                                                "PermitLimit":  40,
                                                                "WindowSeconds":  60
                                                            },
                                               "ExpensiveAstrology":  {
                                                                          "PermitLimit":  20,
                                                                          "WindowSeconds":  60
                                                                      },
                                               "AuthenticatedStandard":  {
                                                                             "PermitLimit":  120,
                                                                             "WindowSeconds":  60
                                                                         },
                                               "Authentication":  {
                                                                      "PermitLimit":  5,
                                                                      "WindowSeconds":  60
                                                                  }
                                           },
                          "Concurrency":  {
                                              "PerUserExpensiveLimit":  20,
                                              "GlobalExpensiveLimit":  50,
                                              "AcquireTimeoutMs":  0
                                          },
                          "RequestSize":  {
                                              "StandardPostBytes":  65536,
                                              "CalculationPostBytes":  262144
                                          },
                          "Caching":  {
                                          "Enabled":  true,
                                          "DefaultExpirationSeconds":  3600,
                                          "MaximumEntries":  10000
                                      },
                          "Timeouts":  {
                                           "StandardCalculationMs":  50000,
                                           "ExpensiveCalculationMs":  120000,
                                           "IntegrationCallMs":  60000,
                                           "HealthCheckMs":  2000
                                       },
                          "CircuitBreaker":  {
                                                 "FailureThreshold":  5,
                                                 "BreakDurationSeconds":  15,
                                                 "SamplingDurationSeconds":  60,
                                                 "SuccessThresholdInHalfOpen":  2
                                             },
                          "Bulkhead":  {
                                           "DefaultMaxConcurrency":  60,
                                           "PartitionOverrides":  {
                                                                      "ai-provider":  30,
                                                                      "geocoding":  30,
                                                                      "astronomy":  60
                                                                  }
                                       },
                          "SsrfProtection":  {
                                                 "Enabled":  true,
                                                 "AllowedSchemes":  [
                                                                        "https"
                                                                    ],
                                                 "BlockPrivateNetworks":  true,
                                                 "BlockMetadataEndpoints":  true,
                                                 "AdditionalBlockedHosts":  [

                                                                            ],
                                                 "ValidateRedirects":  true,
                                                 "MaxRedirects":  5,
                                                 "DnsResolutionTimeoutMs":  4000
                                             },
                          "TrustedProxies":  [

                                             ],
                          "HealthCheckPaths":  [
                                                   "/health/live",
                                                   "/health/ready"
                                               ],
                          "UserIdClaim":  "oid",
                          "IssuerClaim":  "iss"
                      },
    "Observability":  {
                          "ServiceName":  "myvedicstar-authorize-api"
                      },
    "Authentication":  {
                           "RequireAuthenticatedByDefault":  true,
                           "LogTokenRejectionDetails":  false,
                           "EntraExternalId":  {
                                                   "Enabled":  false
                                               },
                           "Google":  {
                                          "Enabled":  false
                                      },
                           "Apple":  {
                                         "Enabled":  false
                                     },
                           "Facebook":  {
                                            "Enabled":  false
                                        }
                       },
    "Authorization":  {
                          "RequiredScopes":  [
                                                 "access_as_user"
                                             ],
                          "ScopeClaimType":  "scp"
                      },
    "Authorize":  {
                      "UserIdentityClaims":  {
                                                 "ExternalUserId":  [
                                                                        "oid"
                                                                    ],
                                                 "Name":  [
                                                              "name"
                                                          ],
                                                 "Email":  [
                                                               "email"
                                                           ]
                                             }
                  },
    "Caching":  {
                    "MaxEntries":  10000,
                    "CompactionPercentage":  0.25,
                    "ExpirationScanFrequency":  "00:01:00"
                },
    "Database":  {
                     "ConnectionString":  "",
                     "CommandTimeout":  "00:00:30",
                     "MaxRetryCount":  3,
                     "MaxRetryDelay":  "00:00:05",
                     "ApplyMigrationsOnStartup":  false
                 }
}