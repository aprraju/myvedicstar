{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Location": {
    "CoordinateDecimalPlaces": 2,
    "NearestCityMaxDistanceKm": 50,
    "CountryHintMaxDistanceKm": 300
  },
  "Traditions": {
    "DefaultTradition": "all"
  },
  "Panchang": {
    "MaxRangeDays": 366,
    "PastDateCacheLifetime": "30.00:00:00",
    "MaxCacheLifetime": "35.00:00:00",
    "PeriodClassifications": {
      "RahuKalam": "Avoid",
      "Yamagandam": "Avoid",
      "DurMuhurtam": "Avoid",
      "GulikaKalam": "Caution",
      "Varjyam": "Avoid",
      "BrahmaMuhurta": "Favorable",
      "AbhijitMuhurta": "Favorable",
      "AmritKalam": "HighlyFavorable",
      "ChoghadiyaAmrit": "HighlyFavorable",
      "ChoghadiyaShubh": "Favorable",
      "ChoghadiyaLabh": "Favorable",
      "ChoghadiyaChal": "Neutral",
      "ChoghadiyaUdveg": "Avoid",
      "ChoghadiyaKaal": "Avoid",
      "ChoghadiyaRog": "Avoid"
    }
  },
  "Festivals": {
    "MaxUpcomingDays": 90,
    "MaxRangeDays": 366,
    "PastDateCacheLifetime": "2.00:00:00",
    "MaxCacheLifetime": "35.00:00:00"
  },
  "Ai": {
    "Enabled": false,
    "Provider": "None",
    "Model": null,
    "MaxOutputTokens": 4000,
    "Anthropic": {
      "Model": "claude-opus-4-6"
    },
    "AzureOpenAI": {
      "Endpoint": null,
      "Deployment": null
    }
  },
  "Muhurta": {
    "DefaultActivity": "general",
    "MaxRangeDays": 366,
    "BestDefaultCount": 3,
    "BestSearchDefaultDays": 30,
    "BestSearchMaxDays": 90,
    "BestMaxCount": 10,
    "OtherTextMaxLength": 80,
    "OtherTextMinimumConfidence": 0.6,
    "PastDateCacheLifetime": "06:00:00",
    "MaxCacheLifetime": "35.00:00:00"
  },
  "DateTimeDisplay": {
    "DefaultDatePattern": "dd/MM/yyyy",
    "TimePattern": "HH:mm:ss",
    "DeriveFromCountryConventions": true,
    "CountryDatePatterns": {
      "US": "MM/dd/yyyy",
      "IN": "dd/MM/yyyy"
    }
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [
      "en"
    ]
  },
  "Content": {
    "Directory": null
  },
  "HealthChecks": {
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "ApiProtection": {
    "RateLimiting": {
      "Global": {
        "PermitLimit": 200,
        "WindowSeconds": 60
      },
      "PublicRead": {
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      "GoodTime": {
        "PermitLimit": 40,
        "WindowSeconds": 60
      },
      "ExpensiveAstrology": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "AuthenticatedStandard": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "Authentication": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      }
    },
    "Concurrency": {
      "PerUserExpensiveLimit": 20,
      "GlobalExpensiveLimit": 50,
      "AcquireTimeoutMs": 0
    },
    "RequestSize": {
      "StandardPostBytes": 65536,
      "CalculationPostBytes": 262144
    },
    "Caching": {
      "Enabled": true,
      "DefaultExpirationSeconds": 3600,
      "MaximumEntries": 10000
    },
    "Timeouts": {
      "StandardCalculationMs": 50000,
      "ExpensiveCalculationMs": 120000,
      "IntegrationCallMs": 60000,
      "HealthCheckMs": 2000
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "BreakDurationSeconds": 15,
      "SamplingDurationSeconds": 60,
      "SuccessThresholdInHalfOpen": 2
    },
    "Bulkhead": {
      "DefaultMaxConcurrency": 60,
      "PartitionOverrides": {
        "ai-provider": 30,
        "geocoding": 30,
        "astronomy": 60
      }
    },
    "SsrfProtection": {
      "Enabled": true,
      "AllowedSchemes": [
        "https"
      ],
      "BlockPrivateNetworks": true,
      "BlockMetadataEndpoints": true,
      "AdditionalBlockedHosts": [],
      "ValidateRedirects": true,
      "MaxRedirects": 5,
      "DnsResolutionTimeoutMs": 4000
    },
    "TrustedProxies": [],
    "HealthCheckPaths": [
      "/health/live",
      "/health/ready"
    ],
    "UserIdClaim": "mvs_user_id",
    "IssuerClaim": "iss"
  },
  "Authentication": {
    "RequireAuthenticatedByDefault": true,
    "LogTokenRejectionDetails": false,
    "EntraExternalId": {
      "Enabled": false
    },
    "Google": {
      "Enabled": false
    },
    "Apple": {
      "Enabled": false
    },
    "Facebook": {
      "Enabled": false
    }
  },
  "Authorization": {
    "RequiredScopes": [
      "access_as_user"
    ],
    "ScopeClaimType": "scp"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ApiDocumentation": {
    "Enabled": true
  },
  "Observability": {
    "ServiceName": "myvedicday-api",
    "OtlpEndpoint": null
  },
  "Caching": {
    "Enabled": true,
    "KeyVersion": "1",
    "MemoryEnabled": true,
    "MemoryLimitBytes": 33554432,
    "MaximumPayloadBytes": 524288,
    "L2": {
      "Enabled": false,
      "Schema": "myvedicstar",
      "Table": "cache_entries",
      "MaximumConnections": 4,
      "MaximumConcurrentOperations": 4,
      "CommandTimeoutSeconds": 2,
      "FailureBackoff": "00:00:10",
      "CleanupInterval": "00:30:00"
    },
    "Policies": {
      "default": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "02:00:00"
      },
      "panchang": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "30.00:00:00"
      },
      "muhurta": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "06:00:00"
      },
      "festivals": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "2.00:00:00"
      },
      "reference": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "2.00:00:00"
      },
      "calculation": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "30.00:00:00"
      },
      "calendar": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "1.00:00:00"
      },
      "historical": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "30.00:00:00"
      }
    }
  }
}
