<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core owns the astronomy contracts and pure value types. It must never reference a provider project:
       providers depend on Core, never the reverse (see SolutionDependencies.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>
    <Description>Provider-neutral astronomy contracts, time scales and value types for MyVedicStar.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- api#140: the UT->TT conversion is internal so no ordinary caller can repoint it. The provider installs it and
         the astronomy test project asserts on it; both are named here rather than widening the property to public. -->
    <InternalsVisibleTo Include="MyVedicDay.Astronomy.Calculation" />
    <InternalsVisibleTo Include="MyVedicDay.Astronomy.Tests.Calculation" />
  </ItemGroup>

</Project>
