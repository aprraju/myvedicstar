{
  // C# (coreclr) debugging for the MyVedicStar Authorize API. F5 runs the first configuration.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Authorize API (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/MyVedicStar.Authorize.Api/bin/Debug/net10.0/MyVedicStar.Authorize.Api.dll",
      "cwd": "${workspaceFolder}/src/MyVedicStar.Authorize.Api",
      "env": {
        // Same as the "http" profile in Properties/launchSettings.json. Secrets come from user secrets.
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5014"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)",
        "uriFormat": "%s/swagger"
      },
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Attach to .NET process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
