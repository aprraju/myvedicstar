<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../MyVedicDay.Api/MyVedicDay.Api.csproj" />
    <ProjectReference Include="../MyVedicStar.Authorize.Api/MyVedicStar.Authorize.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep each API's settings in its own directory to avoid publish filename collisions. -->
    <Content Include="../MyVedicDay.Api/appsettings*.json" Link="apis/day/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../MyVedicStar.Authorize.Api/appsettings*.json" Exclude="../MyVedicStar.Authorize.Api/appsettings.Development.json" Link="apis/star/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="../MyVedicDay.Api/appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="RemoveReferencedApiSettings" BeforeTargets="_HandleFileConflictsForPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Production.json'" />
    </ItemGroup>
  </Target>
</Project>
