<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>4ac006ce-69a4-47df-b37c-0f8df21afd5c</UserSecretsId>
    <!-- Release version. Builds append the source commit (SourceRevisionId) to the informational version. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Shared API protection (rate limiting, request size, correlation, trusted proxies, SSRF). Pin exactly;
         keep the same version in MyVedicStar.Authorize.Api and MyVedicStar.Authorize.Integration. -->
    <PackageReference Include="MyVedicStar.ApiProtection" Version="1.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local-machine settings never leave the developer's machine: excluded from publish output and so from the image. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyVedicStar.Authorize.Business\MyVedicStar.Authorize.Business.csproj" />
    <ProjectReference Include="..\MyVedicStar.Shared\MyVedicStar.Shared.csproj" />
  </ItemGroup>

</Project>
