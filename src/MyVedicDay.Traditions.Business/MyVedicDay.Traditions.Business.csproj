<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MyVedicDay.Localization.Business\MyVedicDay.Localization.Business.csproj" />
    <ProjectReference Include="..\MyVedicDay.Localization.Data\MyVedicDay.Localization.Data.csproj" />
    <ProjectReference Include="..\MyVedicDay.Shared\MyVedicDay.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tradition list and names. WithCulture=false stops MSBuild treating ".en." as a satellite-assembly culture. -->
    <EmbeddedResource Include="Content\traditions.json" LogicalName="MyVedicDay.Traditions.Registry.json" WithCulture="false" />
    <EmbeddedResource Include="Content\*-content.*.json" LogicalName="MyVedicDay.Content.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
