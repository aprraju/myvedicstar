{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "HostOptions": {
    "ShutdownTimeout": "00:00:25"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  },
  "FeatureFlags": {
    "UserPersistence": false
  },
  "TransportSecurity": {
    "RedirectHttpToHttps": true
  },
  "ApiDocumentation": {
    "OpenApiRoutePattern": "/openapi/{documentName}.json",
    "SwaggerEndpointUrl": "/openapi/v1.json",
    "SwaggerUiRoutePrefix": "swagger",
    "Title": "MyVedicStar Authorize API v1",
    "Description": "Sign-in and user profile endpoints for MyVedicStar.",
    "BearerTokenDescription": "Access token issued by Microsoft Entra External ID.",
    "HttpsServerUrlsOnly": true
  },
  "HealthChecks": {
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "ApiProtection": {
    "TrustedProxies": [],
    "HealthCheckPaths": [ "/health/live", "/health/ready" ],
    "UserIdClaim": "oid",
    "IssuerClaim": "iss",
    "RateLimiting": {
      "AuthenticatedStandard": { "PermitLimit": 120, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 },
      "Global": { "PermitLimit": 200, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 }
    },
    "RequestSize": {
      "StandardPostBytes": 65536,
      "CalculationPostBytes": 262144
    },
    "SsrfProtection": {
      "Enabled": true,
      "AllowedSchemes": [ "https" ],
      "BlockPrivateNetworks": true,
      "BlockMetadataEndpoints": true,
      "AdditionalBlockedHosts": [],
      "ValidateRedirects": true,
      "MaxRedirects": 5,
      "DnsResolutionTimeoutMs": 2000
    }
  },
  "Observability": {
    "ServiceName": "myvedicstar-authorize-api"
  },
  "Authentication": {
    "RequireAuthenticatedByDefault": true,
    "LogTokenRejectionDetails": false,
    "EntraExternalId": {
      "Enabled": true,
      "TenantDomain": "",
      "TenantId": "",
      "ClientId": "",
      "ValidateIssuer": true,
      "ValidAlgorithms": [ "RS256" ],
      "ClockSkew": "00:02:00",
      "MetadataAutomaticRefreshInterval": "12:00:00",
      "MetadataRefreshInterval": "00:05:00",
      "MetadataTimeout": "00:00:30"
    },
    "Google": {
      "Enabled": false,
      "ClientId": ""
    },
    "Apple": {
      "Enabled": false,
      "ServiceId": ""
    },
    "Facebook": {
      "Enabled": false,
      "AppId": "",
      "UseOidc": true
    }
  },
  "Authorization": {
    "RequiredScopes": [ "access_as_user" ],
    "ScopeClaimType": "scp"
  },
  "Authorize": {
    "UserIdentityClaims": {
      "ExternalUserId": [ "oid" ],
      "Name": [ "name" ],
      "Email": [ "email" ]
    }
  },
  "Caching": {
    "MaxEntries": 10000,
    "CompactionPercentage": 0.25,
    "ExpirationScanFrequency": "00:01:00"
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeout": "00:00:30",
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05",
    "ApplyMigrationsOnStartup": false
  }
}
