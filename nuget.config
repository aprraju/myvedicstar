<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- MyVedicStar shared packages (MyVedicStar.ApiProtection), published from aprraju/myvedistar-common. -->
    <add key="github-myvedistar" value="https://nuget.pkg.github.com/aprraju/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    GitHub Packages always requires authentication, even to read.

    Local development: create a GitHub personal access token (classic) with the read:packages scope, then
      PowerShell:     $env:GITHUB_TOKEN = "<token>"
      bash/zsh:       export GITHUB_TOKEN="<token>"
    and restore as usual. Never commit a real token.

    GitHub Actions: the workflow sets GITHUB_TOKEN from secrets.GITHUB_TOKEN (permission packages: read).
    The package must grant this repository read access: package settings → Manage Actions access.
  -->
  <packageSourceCredentials>
    <github-myvedistar>
      <add key="Username" value="aprraju" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-myvedistar>
  </packageSourceCredentials>

  <!-- MyVedicStar.* only from GitHub Packages, everything else only from nuget.org (prevents dependency confusion). -->
  <packageSourceMapping>
    <packageSource key="github-myvedistar">
      <package pattern="MyVedicStar.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
