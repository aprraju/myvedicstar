{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "GeoNames": {
    "Enabled": true,
    "Username": "aprraju",
    "TimeoutSeconds": 10,
    "SearchCacheHours": 24,
    "CoordinateCacheDays": 7
  },
  "HostOptions": {
    "ShutdownTimeout": "00:00:25"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  },
  "FeatureFlags": {
    "UserPersistence": false
  },
  "TransportSecurity": {
    "RedirectHttpToHttps": true
  },
  "ApiDocumentation": {
    "OpenApiRoutePattern": "/openapi/{documentName}.json",
    "SwaggerEndpointUrl": "/openapi/v1.json",
    "SwaggerUiRoutePrefix": "swagger",
    "Title": "MyVedicStar Authorize API v1",
    "Description": "Sign-in and user profile endpoints for MyVedicStar.",
    "BearerTokenDescription": "Access token issued by Microsoft Entra External ID.",
    "HttpsServerUrlsOnly": true
  },
  "HealthChecks": {
    "LivenessPath": "/health/live",
    "ReadinessPath": "/health/ready"
  },
  "ApiProtection": {
    "RateLimiting": {
      "Global": {
        "PermitLimit": 200,
        "WindowSeconds": 60
      },
      "PublicRead": {
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "GoodTime": {
        "PermitLimit": 40,
        "WindowSeconds": 60
      },
      "ExpensiveAstrology": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "AuthenticatedStandard": {
        "PermitLimit": 180,
        "WindowSeconds": 60
      },
      "Authentication": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      }
    },
    "Concurrency": {
      "PerUserExpensiveLimit": 30,
      "GlobalExpensiveLimit": 120,
      "AcquireTimeoutMs": 0
    },
    "RequestSize": {
      "StandardPostBytes": 65536,
      "CalculationPostBytes": 262144
    },
    "Caching": {
      "Enabled": true,
      "DefaultExpirationSeconds": 3600,
      "MaximumEntries": 10000
    },
    "Timeouts": {
      "StandardCalculationMs": 60000,
      "ExpensiveCalculationMs": 120000,
      "IntegrationCallMs": 60000,
      "HealthCheckMs": 2000
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "BreakDurationSeconds": 15,
      "SamplingDurationSeconds": 60,
      "SuccessThresholdInHalfOpen": 2
    },
    "Bulkhead": {
      "DefaultMaxConcurrency": 60,
      "PartitionOverrides": {
        "ai-provider": 30,
        "geocoding": 30,
        "astronomy": 60
      }
    },
    "SsrfProtection": {
      "Enabled": true,
      "AllowedSchemes": [
        "https"
      ],
      "BlockPrivateNetworks": true,
      "BlockMetadataEndpoints": true,
      "AdditionalBlockedHosts": [],
      "ValidateRedirects": true,
      "MaxRedirects": 5,
      "DnsResolutionTimeoutMs": 4000
    },
    "TrustedProxies": [],
    "HealthCheckPaths": [
      "/health/live",
      "/health/ready"
    ],
    "UserIdClaim": "oid",
    "IssuerClaim": "iss"
  },
  "Observability": {
    "ServiceName": "myvedicstar-authorize-api"
  },
  "Authentication": {
    "RequireAuthenticatedByDefault": true,
    "LogTokenRejectionDetails": false,
    "EntraExternalId": {
      "Enabled": false
    },
    "Google": {
      "Enabled": false
    },
    "Apple": {
      "Enabled": false
    },
    "Facebook": {
      "Enabled": false
    }
  },
  "Authorization": {
    "RequiredScopes": [
      "access_as_user"
    ],
    "ScopeClaimType": "scp"
  },
  "Authorize": {
    "UserIdentityClaims": {
      "ExternalUserId": [
        "oid"
      ],
      "Name": [
        "name"
      ],
      "Email": [
        "email"
      ]
    }
  },
  "Caching": {
    "Enabled": true,
    "KeyVersion": "1",
    "MemoryEnabled": true,
    "MemoryLimitBytes": 33554432,
    "MaximumPayloadBytes": 524288,
    "L2": {
      "Enabled": false,
      "Schema": "myvedicstar",
      "Table": "cache_entries",
      "MaximumConnections": 4,
      "MaximumConcurrentOperations": 4,
      "CommandTimeoutSeconds": 2,
      "FailureBackoff": "00:00:10",
      "CleanupInterval": "00:30:00"
    },
    "Policies": {
      "default": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "02:00:00"
      },
      "panchang": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "30.00:00:00"
      },
      "muhurta": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "06:00:00"
      },
      "festivals": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "2.00:00:00"
      },
      "reference": {
        "MemoryLifetime": "00:05:00",
        "DistributedLifetime": "2.00:00:00"
      },
      "calculation": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "30.00:00:00"
      },
      "calendar": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "1.00:00:00"
      },
      "historical": {
        "MemoryLifetime": "00:00:00",
        "DistributedLifetime": "30.00:00:00"
      }
    }
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeout": "00:00:30",
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05",
    "ApplyMigrationsOnStartup": false
  }
}
